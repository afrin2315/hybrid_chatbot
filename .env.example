FLASK_SECRET_KEY=replace-with-a-long-random-secret

# --- Response LLM (optional; classifier + safety cascade work without it) ---
# Provider order tried at runtime: NVIDIA Nemotron -> Gemini -> local templates.
# Put REAL keys only in .env (gitignored), NEVER here in .env.example.
# NVIDIA (key from build.nvidia.com; OpenAI-compatible API):
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
# Or Google Gemini instead:
GEMINI_API_KEY=your-gemini-api-key

DB_PATH=app.db
HOST=127.0.0.1
PORT=5000
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
# Serve on fast+safety tiers only (skip DistilBERT), e.g. during retraining:
# DISABLE_ACCURATE_TIER=1
